# Copy this file to .env and fill in real values before running.

# Postgres connection string. Free options: Railway, Neon, Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/orange_health_ajo"

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-this-with-a-real-random-secret"

# From your Paystack dashboard (Settings > API Keys & Webhooks).
# Use the TEST secret key while developing — starts with sk_test_
PAYSTACK_SECRET_KEY="sk_test_replace_me"

PORT=3000

# Where the frontend runs — Paystack redirects members back here after payment.
FRONTEND_URL="http://localhost:5173"

# From resend.com — free tier is generous. Before you have a verified domain,
# leave EMAIL_FROM as-is; Resend's shared test address works with zero setup.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="onboarding@resend.dev"
